# ==========================================================
# NOVABANK DIGITAL - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como .env.local antes de iniciar:
# cp .env.example .env.local
# ==========================================================

# Nombre público de la institución financiera
NEXT_PUBLIC_BANK_NAME="NovaBank Digital"

# Endpoint de API externa para tasas de cambio en tiempo real (ExchangeRate-API abierta)
NEXT_PUBLIC_FX_API_URL="https://open.er-api.com/v6/latest/USD"

# Moneda base del sistema bancario
NEXT_PUBLIC_BASE_CURRENCY="USD"

# Clave interna simulada para validación en Route Handlers (Server-side only)
BANK_INTERNAL_API_SECRET="novabank_dev_secret_key_2026"
