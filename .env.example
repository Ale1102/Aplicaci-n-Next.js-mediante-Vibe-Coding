# ==========================================================
# NOVABANK DIGITAL - VARIABLES DE ENTORNO
# Copia este archivo como .env.local antes de iniciar:
#   Windows (PowerShell): Copy-Item .env.example .env.local
#   macOS / Linux:        cp .env.example .env.local
# Nunca subas .env.local al repositorio.
# ==========================================================

# Nombre público de la entidad (visible en el navegador, por eso NEXT_PUBLIC_)
NEXT_PUBLIC_BANK_NAME="NovaBank Digital"

# Endpoint de tasas de cambio. Solo se lee en el servidor (/api/fx y el dashboard).
# Si no se define se usa https://open.er-api.com/v6/latest/USD
FX_API_URL="https://open.er-api.com/v6/latest/USD"
